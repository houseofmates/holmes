#!/usr/bin/env python3
"""
holmes-verify — verify a .holmes file is valid and round-trips correctly.

usage:
  holmes-verify <file.holmes> [file.holmes ...]

checks:
  1. magic bytes
  2. header byte sizes are consistent
  3. payload length field matches actual remaining bytes
  4. (optional) payload data itself is valid by re-detecting mime via `file`
"""

import sys
import struct
import subprocess
import argparse
from pathlib import Path

MAGIC = b'HOLMES'


def verify(data: bytes, path: str = '<stream>') -> list[str]:
    errors = []

    if len(data) < 18:
        return [f'{path}: file too small ({len(data)} bytes) — cannot contain header']
    if data[:6] != MAGIC:
        return [f'{path}: bad magic bytes (got {data[:6]!r})']
    if len(data) < 10:
        return [f'{path}: file truncated at mime_len field']

    version = struct.unpack('>H', data[6:8])[0]
    mime_len = struct.unpack('>H', data[8:10])[0]

    if version != 1:
        errors.append(f'{path}: unexpected version {version} (expected 1)')

    expected_min = 10 + mime_len + 8
    if len(data) < expected_min:
        errors.append(f'{path}: file truncated — need {expected_min} header bytes, got {len(data)}')
        return errors

    mime_str = data[10:10 + mime_len].decode('ascii', errors='replace')
    payload_start = 10 + mime_len + 8
    payload_len = struct.unpack('>Q', data[10 + mime_len:payload_start])[0]

    actual_payload = data[payload_start:]
    if len(actual_payload) != payload_len:
        errors.append(
            f'{path}: payload length mismatch — header says {payload_len}, found {len(actual_payload)}'
        )

    # optional: verify payload is actual media
    import tempfile, os
    try:
        with tempfile.NamedTemporaryFile(delete=False, suffix='') as tmp:
            tmp.write(actual_payload[:131072])  # only first 128 kb for speed
            tmp.flush()
            r = subprocess.run(
                ['file', '--mime-type', '-b', tmp.name],
                capture_output=True, text=True, timeout=5
            )
            detected = r.stdout.strip()
        os.unlink(tmp.name)
        if detected and detected != 'application/octet-stream':
            if not mime_str.startswith(detected.split('/')[0]):
                errors.append(
                    f'{path}: mime mismatch — header says "{mime_str}", file says "{detected}"'
                )
    except Exception:
        pass  # skip media verification if file command unavailable

    return errors


def main():
    p = argparse.ArgumentParser(description='verify .holmes files are well-formed')
    p.add_argument('files', nargs='+', help='.holmes file(s) to verify')
    args = p.parse_args()

    total = 0
    ok_count = 0
    fail_count = 0

    for path in args.files:
        total += 1
        try:
            data = Path(path).read_bytes()
        except Exception as e:
            print(f'❌ {path}: cannot read — {e}')
            fail_count += 1
            continue

        errors = verify(data, path)
        if errors:
            for e in errors:
                print(f'❌ {e}')
            fail_count += 1
        else:
            payload_start = 10 + struct.unpack('>H', data[8:10])[0] + 8
            payload_len = struct.unpack('>Q', data[10 + struct.unpack('>H', data[8:10])[0]:payload_start])[0]
            mime_str = data[10:10 + struct.unpack('>H', data[8:10])[0]].decode('ascii', errors='replace')
            print(f'✅ {path}  mime={mime_str}  payload={payload_len:,} bytes  overhead={payload_start} bytes')
            ok_count += 1

    print(f"\n{ok_count}/{total} passed, {fail_count} failed")
    sys.exit(1 if fail_count else 0)


if __name__ == '__main__':
    main()
